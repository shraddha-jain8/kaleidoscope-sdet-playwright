{
  "name": "kaleidoscope-sdet-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript solution for the Kaleidoscope SDET scholarship applicant flow",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
